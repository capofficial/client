```javascript
// WelcomeModal.js
import React from 'react';
import Modal from 'react-modal';

const WelcomeModal = () => {
  const [isOpen, setIsOpen] = React.useState(true);

  const handleClose = () => {
    setIsOpen(false);
    localStorage.setItem('welcomeModalSeen', 'true');
  };

  if (localStorage.getItem('welcomeModalSeen') === 'true') {
    return null;
  }

  return (
    <Modal
      isOpen={isOpen}
      onRequestClose={handleClose}
      contentLabel="Welcome Modal"
    >
      <h2>Welcome to CAP!</h2>
      <p>CAP is a trading dashboard that allows you to manage your funds and trade assets.</p>
      <h3>Getting Started</h3>
      <ul>
        <li>Use the navigation menu to access different features of the dashboard.</li>
        <li>To bridge funds from Arbitrum, click on the "Bridge" button below.</li>
      </ul>
      <button onClick={handleClose}>Close</button>
      <button onClick={() => window.open('https://bridge.capofficial.io', '_blank')}>Bridge Funds</button>
    </Modal>
  );
};

export default WelcomeModal;
```

